{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/fuel_record.schema.json",
  "title": "FuelRecord",
  "status": "FROZEN v1.0",
  "status_note": "Field list verbatim from DISPATCH_BUILD_BLUEPRINT_v1 Part 1.2. Frozen 2026-08-04 on approval of #2 (dual-record fuel, Decision D1). Formerly contracts/fuel_record.DRAFT.json — renamed on freeze; see docs/decisions/DECISION_LOG.md.",
  "type": "object",
  "properties": {
    "fuel_record_id": { "type": "string", "description": "ULID. Primary key." },
    "evidence_record_id": { "type": "string" },
    "expense_record_id": { "type": "string", "description": "The D1 cross-link. Decision D1 (dual-record fuel) is ADOPTED: a propulsion-fuel line item emits BOTH a FuelRecord and an ExpenseRecord (category fuel), cross-linked, sharing one EvidenceRecord parent." },
    "purchase_date": { "type": "string", "format": "date" },
    "purchase_time": { "type": ["string", "null"], "format": "time" },
    "vendor_name": { "type": "string" },
    "vendor_address": { "type": "string" },
    "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 2, "description": "State/province code, derived from vendor_address. Never guessed." },
    "fuel_type": { "type": "string", "enum": ["diesel", "gasoline"] },
    "tractor_or_reefer": { "type": "string", "enum": ["tractor", "reefer"], "description": "Reefer excludes from IFTA gallons." },
    "volume_as_received": { "type": "number" },
    "volume_as_received_unit": { "type": "string", "enum": ["gallons", "liters"] },
    "gallons_normalized": { "type": "number", "description": "liters x 0.264172 when needed." },
    "unit_price": { "type": "number" },
    "total_amount": { "type": "number" },
    "currency": { "type": "string", "enum": ["USD", "CAD"] },
    "taxes_included": { "type": "boolean" },
    "unit_number": { "type": "string" },
    "driver": { "type": ["string", "null"] },
    "odometer": { "type": ["integer", "null"] },
    "payment_method": { "type": ["string", "null"] },
    "card_last4": { "type": ["string", "null"] },
    "receipt_number": { "type": ["string", "null"] },
    "dedup_key": { "type": "string", "description": "sha256(vendor_name + purchase_date + total_amount + gallons_normalized + card_last4)." },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_status": { "type": "string", "enum": ["auto", "human_confirmed", "quarantined"] },
    "schema_version": { "type": "string", "const": "1.0" }
  },
  "required": ["fuel_record_id", "evidence_record_id", "expense_record_id", "purchase_date", "vendor_name", "vendor_address", "jurisdiction", "fuel_type", "tractor_or_reefer", "volume_as_received", "volume_as_received_unit", "gallons_normalized", "unit_price", "total_amount", "currency", "taxes_included", "unit_number", "dedup_key", "extraction_confidence", "review_status", "schema_version"],
  "additionalProperties": false,
  "routing_note": "Reefer-flagged fuel emits an ExpenseRecord only (category reefer_fuel), no FuelRecord. DEF is never a FuelRecord under any circumstance. Router that actually implements this routing is Lane C build work, not yet written."
}
